# Node 24.13+; one persistent Node instance. Never put this DB on an ephemeral filesystem.
DATABASE_PATH=./data/deskhop.sqlite
APP_URL=http://127.0.0.1:3000
# Explicit sample catalog, never authorized real-world inventory.
SEED_DEMO=true
# Real venue facts sourced from official websites; no native real-world room inventory.
SEED_REAL=true
# Required for production account verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DeskHop <hello@example.com>
# Optional error reporting destination is intentionally not configured.

# Managed production login (Firebase Spark). Web configuration is public; service account JSON is secret.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Premium: recurring USD 7.99/month price, verified through Stripe webhooks.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# AI remains disabled unless a provider, model, and positive daily quota are explicitly configured.
AI_API_KEY=
AI_MODEL=
AI_DAILY_CALL_LIMIT=0
